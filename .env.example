# Seizr environment — copy to .env and fill in. Load via docker --env-file .env,
# systemd EnvironmentFile=, or `set -a; source .env; set +a` for local dev.
# (Nothing here is read automatically unless you load it.)

# --- secrets ---------------------------------------------------------------
# Strong random value; encrypts stored Minecraft refresh tokens. REQUIRED in prod.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SEIZR_SECRET_KEY=

# Set to 1 when served over HTTPS (marks session cookies Secure).
SECURE_COOKIES=1

# --- email (Resend over SMTP) ----------------------------------------------
# Create an API key at resend.com (Settings -> API Keys). Username is literally
# "resend"; password is the API key. Verify your sending domain (SPF + DKIM) to
# send from @seizr.io; until then use onboarding@resend.dev (test recipient only).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM=no-reply@seizr.io

# --- Google sign-in (optional) ---------------------------------------------
# Google Cloud console -> OAuth client. Redirect URI:
#   https://<your-host>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- database (optional override) ------------------------------------------
# SEIZR_DB=/data/seizr.db
# AUTH_CACHE=/data/.auth_cache.json   # CLI single-user token cache
